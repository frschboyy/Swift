                },
                {
                  "type": "text",
                  "id": "FOuuM",
                  "name": "Opaque, Mica-like layers wit",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Opaque, Mica-like layers with no glass and no bands. Edges sit one step darker than the card, and their spines carry the state, so a stack of them never blends into the card.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "x73b2Y",
