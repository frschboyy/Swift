                  "fill": "#1A1A1A",
                  "content": "Presence exceptions (10, 11)",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "veXTy",
                  "name": "The 5 px rail is the lightes",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The 5 px rail is the lightest presence of the three. Whenever Swift speaks or the mic is off, the full dock replaces it under the card, so the privacy state never shrinks to a line.",
