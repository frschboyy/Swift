                                    0,
                                    14,
                                    2,
                                    14
                                  ],
                                  "children": [
                                    {
                                      "type": "icon",
                                      "id": "ts6YD",
                                      "name": "mic",
                                      "width": 14,
                                      "height": 14,
                                      "icon": "mic",
                                      "library": "lucide",
                                      "fill": "$c-faint"
                                    },
                                    {
                                      "type": "text",
                                      "id": "V4PUx",
                                      "name": "Words",
                                      "fill": "$c-muted",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "“Give me a short history of tea”",
                                      "fontFamily": "$font-text",
                                      "fontSize": 14,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "CpWb7",
                                  "name": "Body",
                                  "clip": true,
                                  "width": "fill_container",
                                  "height": 280,
                                  "gap": 10,
                                  "padding": [
                                    10,
                                    8,
                                    0,
                                    14
                                  ],
                                  "children": [
                                    {
                                      "type": "frame",
                                      "id": "x56s2L",
                                      "name": "Text",
                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "gap": 10,
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "J25qq",
                                          "name": "Paragraph",
                                          "fill": "$c-text",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "Tea began in southwest China, where leaves of Camellia sinensis were boiled as medicine as early as the Shang dynasty.",
                                          "lineHeight": 1.55,
                                          "fontFamily": "$font-text",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "gHNdH",
                                          "name": "Paragraph",
                                          "fill": "$c-text",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "Under the Tang it became a daily drink. Lu Yu wrote The Classic of Tea around 760 CE, setting out how to grow, prepare and serve it, and powdered tea whisked in bowls spread to Japan with Buddhist monks.",
                                          "lineHeight": 1.55,
                                          "fontFamily": "$font-text",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "VKVvh",
                                          "name": "Paragraph",
                                          "fill": "$c-text",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "The Song refined it further; the Ming switched to loose leaves steeped in pots, which is how most of the world drinks it now.",
                                          "lineHeight": 1.55,
                                          "fontFamily": "$font-text",
                                          "fontSize": 16,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "v3syBj",
                                          "name": "Paragraph",
                                          "fill": "$c-text",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
