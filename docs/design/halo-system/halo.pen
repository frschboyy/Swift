                {
                  "type": "text",
                  "id": "ToC9P",
                  "name": "Tail x = orb centre − card l",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Tail x = orb centre − card left − 12, clamped to 28 … card width − 52 so it never meets the 22 px corner. Bottom anchors: tail on the card's bottom edge, pointing down. Top anchors: on the top edge, pointing up, and the card's square corners swap to the edge side.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "mVlRy",
              "name": "Compact confirm (rule)",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "d0ryp",
                  "name": "Compact confirm (rule)",
                  "fill": "#121522",
                  "content": "Compact confirm (rule)",
                  "fontFamily": "$font-text",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "C9hsIp",
                  "name": "Applies only when edges are ",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Applies only when edges are behind a Needs your OK card and card + deck would exceed the window's free height. Then: band 42 → 36 px, body gap 14 → 10, facts padding 12 → 10, email preview clamped to two lines, footer padding 14 → 10. Never removed: any fact, the voice rule, any button, the countdown. Measured: 412 → 341 px, so three edges fit in 443 of 466 px.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "a0ayf",
              "name": "If it still doesn't fit",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "children": [
                {
                  "type": "text",
                  "id": "w7mPde",
                  "name": "If it still doesn't fit",
                  "fill": "#121522",
                  "content": "If it still doesn't fit",
                  "fontFamily": "$font-text",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Z2LyjK",
                  "name": "Fold the deck to one edge (“",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
