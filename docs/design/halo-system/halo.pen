                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "“Give me a short history of tea”",
                                  "textAlign": "right",
                                  "fontFamily": "$font-text",
                                  "fontSize": 14,
                                  "fontWeight": "normal"
                                },
                                {
                                  "type": "icon",
