              "children": [
                {
                  "type": "text",
                  "id": "MsvGa",
                  "name": "Tightest fit (12)",
                  "fill": "#1A1A1A",
                  "content": "Tightest fit (12)",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "nI5Dd",
                  "name": "A confirm card with three ed",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A confirm card with three edges behind uses 455 of the 493 px the window leaves above the rail, with 38 px to spare. Rail is the only direction with room for a longer email preview.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "z3TGLq",
              "name": "Presence exceptions (10, 11)",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                14,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "E8Kpn3",
                  "name": "Presence exceptions (10, 11)",
                  "fill": "#1A1A1A",
                  "content": "Presence exceptions (10, 11)",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "veXTy",
                  "name": "The 5 px rail is the lightes",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The 5 px rail is the lightest presence of the three. Whenever Swift speaks or the mic is off, the full dock replaces it under the card, so the privacy state never shrinks to a line.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "wdfzf",
              "name": "One spine colour per meaning (14)",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                14,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "yyjw6",
                  "name": "One spine colour per meaning",
                  "fill": "#1A1A1A",
                  "content": "One spine colour per meaning (14)",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "wkczo",
                  "name": "Green: an answer or ready. B",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Green: an answer or ready. Blue: working or asking. Amber: an OK. Stripes: not listening. A folded deck hiding an OK turns its spine amber.",
                  "lineHeight": 1.5,
