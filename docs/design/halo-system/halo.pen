              "children": [
                {
                  "type": "text",
                  "id": "vqOLN",
                  "name": "How to read this board",
                  "fill": "#121522",
                  "content": "How to read this board",
                  "fontFamily": "$font-text",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "hy0VT",
                  "name": "BUILT means drawn as Swift i",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "BUILT means drawn as Swift is on main today. PROPOSAL means not built yet: don't build it without the owner's go-ahead. Every frame has a dark row and a light row. Stages are the overlay window (720 × 560) at its anchor, with a 16 px gutter.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Uhycf",
                  "name": "Type: Open Sans stands in fo",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Type: Open Sans stands in for Segoe UI Variable, and JetBrains Mono for Cascadia Mono.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "oUREp",
          "name": "B5  Cards that grow, and exp",
          "fill": "#121522",
          "content": "B5  Cards that grow, and expand by hand",
          "fontFamily": "$font-display",
          "fontSize": 32,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "LfFpv",
          "name": "The card grows with its cont",
          "fill": "#3A3F4D",
          "textGrowth": "fixed-width",
          "width": 1600,
          "content": "The card grows with its content up to the cap: the window's free height (560) minus the gutters (2 × 16), the orb (36) and the gap (10) = 482 px, less 34 px for each deck edge shown. At the cap the body stops, a fade marks the cut, and Show all expands it. Expanding is always by hand; nothing grows over your work on its own.",
          "lineHeight": 1.45,
          "fontFamily": "$font-text",
          "fontSize": 17,
          "fontWeight": "normal"
        },
