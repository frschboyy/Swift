                },
                {
                  "type": "text",
                  "id": "c0J8f",
                  "name": "Swift as a well-set page. Op",
                  "fill": "#2A2C32",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Swift as a well-set page. Opaque matte sheets, hairline rules and type carry the hierarchy, with no glass and no glow. Swift's presence is a small nameplate with a violet pilot light.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-text",
                  "fontSize": 20,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "k1SFN",
                  "name": "Font note",
                  "fill": "#6B6E76",
                  "content": "Type is shown in Open Sans as a stand-in. Build in Segoe UI Variable.",
                  "fontFamily": "$font-text",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "s6JBN",
              "name": "Form",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                18,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "cGzOV",
                  "name": "Form",
                  "fill": "#131418",
                  "content": "Form",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "bBIQ2",
                  "name": "Squared sheets with a 6 px r",
                  "fill": "#3C3F47",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Squared sheets with a 6 px radius. The capsule becomes a nameplate. While a card is open it shrinks to the pilot light alone. Edges are index tabs resting on the card's top edge, each one tone further from the card.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "K1BvOc",
              "name": "Material",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                18,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "Kpusr",
                  "name": "Material",
                  "fill": "#131418",
                  "content": "Material",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "w03om",
                  "name": "Fully opaque: one hairline a",
                  "fill": "#3C3F47",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Fully opaque: one hairline and one soft shadow. Legible on any wallpaper because nothing is see-through. Footers share the card's surface and sit under a rule, which removes the band.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "I3ML8v",
              "name": "Presence and privacy",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 8,
              "padding": [
                18,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "QI41f",
                  "name": "Presence and privacy",
                  "fill": "#131418",
                  "content": "Presence and privacy",
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "QKbcc",
                  "name": "The pilot light means Swift ",
                  "fill": "#3C3F47",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The pilot light means Swift is here. Listening lights it violet with a level meter. Not listening inverts the whole nameplate (light on dark, dark on light), so the privacy state reads at a glance.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
