                },
                {
                  "type": "text",
                  "id": "wxCW8",
                  "name": "Sheets slide 8 px out of the",
                  "fill": "#3C3F47",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Sheets slide 8 px out of the nameplate and settle (280 ms, standard curve, no overshoot). A new tab slides out of the nameplate and files into its slot. Read more tucks the tabs into one. Reduced motion: a 120 ms fade.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
