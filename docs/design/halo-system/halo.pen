                },
                {
                  "type": "text",
                  "id": "OQRBd",
                  "name": "Cards that grow, and motion ",
                  "fill": "#121522",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Cards that grow, and motion you can see",
                  "lineHeight": 1.1,
                  "fontFamily": "$font-display",
                  "fontSize": 52,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "Aw6OW",
                  "name": "A card grows with what it sa",
                  "fill": "#262B3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A card grows with what it says until it would cover your work, then it stops and offers Show all. You expand it by hand, and it folds back the same way. Motion shows where things come from: the card grows out of the orb and folds back into it.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-text",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
            {
