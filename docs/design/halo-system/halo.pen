                              "name": "Body",
                              "clip": true,
                              "width": "fill_container",
                              "height": 290,
                              "gap": 10,
                              "padding": [
                                8,
                                10,
                                0,
                                22
                              ],
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "ZWrAp",
                                  "name": "Text",
                                  "width": "fill_container",
                                  "layout": "vertical",
                                  "gap": 10,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "c4Voa",
                                      "name": "Paragraph",
                                      "fill": "$b-text",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Tea began in southwest China, where leaves of Camellia sinensis were boiled as medicine as early as the Shang dynasty.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "$font-text",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "bAF3c",
                                      "name": "Paragraph",
                                      "fill": "$b-text",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Under the Tang it became a daily drink. Lu Yu wrote The Classic of Tea around 760 CE, setting out how to grow, prepare and serve it, and powdered tea whisked in bowls spread to Japan with Buddhist monks.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "$font-text",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "rFR6q",
                                      "name": "Paragraph",
                                      "fill": "$b-text",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "The Song refined it further; the Ming switched to loose leaves steeped in pots, which is how most of the world drinks it now.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "$font-text",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "DRUq5",
                                      "name": "Paragraph",
                                      "fill": "$b-text",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Tea reached Europe in the 17th century through Dutch and Portuguese traders.",
                                      "lineHeight": 1.5,
                                      "fontFamily": "$font-text",
                                      "fontSize": 17,
                                      "fontWeight": "normal"
                                    }
                                  ]
