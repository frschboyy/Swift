                },
                {
                  "type": "text",
                  "id": "G8Vkbf",
                  "name": "Fluent geometry: an 8 px rad",
                  "fill": "#3A3A3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Fluent geometry: an 8 px radius, a 4 px state spine on every card and edge, and a command bar for actions. While a card is open, Swift shrinks to a short rail under it, like the taskbar's active-app line.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            },
            {
