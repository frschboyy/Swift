            16,
            20
          ],
          "children": [
            {
              "type": "text",
              "id": "lonbr",
              "name": "Note · B7",
              "fill": "#2357C9",
              "content": "Note · B7",
              "fontFamily": "$font-text",
              "fontSize": 13,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "K9zIy",
              "name": "Chose: motion that carries m",
              "fill": "#262B3A",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Chose: motion that carries meaning. Cards scale out of the orb's corner (280 ms, ease-out, no overshoot) and fold back into it faster (220 ms, ease-in), so arriving is noticeable and leaving never holds you up. The tail lands last, which ties the bubble to the orb. Edges come forward with Halo's existing ease (320 ms). Done drifts 8 px towards the orb as it fades. Reduced motion turns every one of these into a 120 ms crossfade and keeps the reading bar. Rejected: springs and overshoot (playful, and they read as \"look at me\" on a surface that should stay quiet); a blur-in (glass is decoration only, and blur animation is costly on a full-screen layered window); longer than 320 ms anywhere (felt slow in the 150% check). Question for the owner: should the orb's \"something is coming\" brighten also happen for runs Swift started, or only for answers you asked for?",
              "lineHeight": 1.5,
              "fontFamily": "$font-text",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "P4Tp2J",
      "x": 12400,
      "y": 0,
      "name": "Halo · B8 · Watch (B6, B9, B10, B11, B12)",
      "width": 5200,
      "fill": "#E8EBF2",
      "layout": "vertical",
      "gap": 56,
      "padding": 72,
      "children": [
        {
          "type": "frame",
          "id": "P9yMvS",
          "name": "Header",
          "width": "fill_container",
          "gap": 56,
          "children": [
            {
              "type": "frame",
              "id": "W6hIGj",
              "name": "Title",
              "width": 1100,
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "mxQ0M",
                  "name": "Halo · B8 · Board 5 · B6 mon",
                  "fill": "#2357C9",
                  "content": "Halo · B8 · Board 5 · B6 monitor · B9 docking · B10 one run · B11 life · B12 open the answer",
                  "fontFamily": "$font-text",
                  "fontSize": 18,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "uRxV0",
                  "name": "The watch: a monitor, not a ",
                  "fill": "#121522",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The watch: a monitor, not a card",
                  "lineHeight": 1.1,
                  "fontFamily": "$font-display",
                  "fontSize": 52,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ECJ0v",
                  "name": "The watch is Swift's window ",
                  "fill": "#262B3A",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Decided, not built: the watch becomes a monitor, solid near-black in both themes, with Cascadia Mono for steps and times, so it can never be mistaken for a card, let alone an approval. Today it is a window beside the card in Halo's card styles. It belongs to its request: same title, same clock, and a visible link.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-text",
                  "fontSize": 20,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "q6OfRs",
              "name": "Key",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "padding": [
                24,
                0,
                0,
                0
              ],
              "children": [
                {
                  "type": "text",
                  "id": "Ag6Q5",
                  "name": "What the watch never does",
                  "fill": "#121522",
                  "content": "What the watch never does",
                  "fontFamily": "$font-text",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "B16cpe",
                  "name": "No glass, no rim, no state l",
                  "fill": "#3A3F4D",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No glass, no rim, no state line, no tail, no amber, no approve button. It never takes focus. An OK that a watched run needs appears as its own Needs your OK card at the orb, never inside the watch.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-text",
                  "fontSize": 15,
                  "fontWeight": "normal"
                }
              ]
            }
          ]
        },
        {
          "type": "text",
          "id": "c5kPR",
          "name": "B6 + B11  The monitor, polis",
          "fill": "#121522",
          "content": "B6 + B11  The monitor (decided, not built), with signs of life",
          "fontFamily": "$font-display",
          "fontSize": 32,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "EvHa1",
          "name": "Left: the watch as built aft",
          "fill": "#3A3F4D",
          "textGrowth": "fixed-width",
          "width": 1600,
          "content": "Left: the watch as built today, in Halo's card styles (LIVE badge, sources, notes). Right: the monitor look the owner has decided on but which isn't built, with its polish: a 2 px progress line under the title bar, a step counter with an estimate, steps that tick from › to ✓ with their times, sources with a state each, and a LIVE pulse every 2 s (static with reduced motion). The paper view keeps one console line under the page.",
          "lineHeight": 1.45,
          "fontFamily": "$font-text",
          "fontSize": 17,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "V6aQ1F",
          "name": "B6 · monitor",
          "gap": 40,
          "children": [
            {
              "type": "frame",
              "id": "XaeJZ",
              "name": "1  As built (B6)",
              "width": 480,
              "layout": "vertical",
              "gap": 12,
              "children": [
                {
                  "type": "frame",
                  "id": "NBC75",
