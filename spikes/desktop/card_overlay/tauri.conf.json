{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftCardSpike",
  "version": "0.0.0",
  "identifier": "dev.swift.spike.cardoverlay",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "canvas",
        "title": "Swift card spike",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../../overlay/src-tauri/icons/icon.ico"]
  }
}
