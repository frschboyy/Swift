                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "cpMr8",
                      "name": "Speaking and Not listening r",
                      "fill": "#3A3F4D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Speaking and Not listening replace the bare orb under the card, and the tail points at them instead. The sleeping orb stays beside an open card for as long as the mic is off.",
